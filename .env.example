# Start-up values only. Upload size, timeouts, quota and concurrency are settings: change them on the admin page (/admin/);
# a saved value beats .env.
# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
LENS_HOST=127.0.0.1
LENS_PORT=8093
# Docker only: 0.0.0.0 = reachable on the LAN; 127.0.0.1 = this machine only.
LENS_BIND=127.0.0.1
# Unlocks /admin/ (settings, usage). Empty = page off.
LENS_ADMIN_PASSWORD=
# The TesseractModel address and token are not set here: save a connection on the admin page (/admin/).
